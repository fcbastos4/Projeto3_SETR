  Node1 -> Node1 [id="edge2_Node000001_Node000001",dir="back",color="darkorchid3",style="dashed",tooltip=" ",label=" notify_drop",fontcolor="grey" ];
  Node3 -> Node1 [id="edge3_Node000001_Node000003",dir="back",color="darkorchid3",style="dashed",tooltip=" ",label=" get_wlen",fontcolor="grey" ];
