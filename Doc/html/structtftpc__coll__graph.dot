digraph "tftpc"
{
 // LATEX_PDF_SIZE
  bgcolor="transparent";
  edge [fontname=Helvetica,fontsize=10,labelfontname=Helvetica,labelfontsize=10];
  node [fontname=Helvetica,fontsize=10,shape=box,height=0.2,width=0.4];
  Node1 [id="Node000001",label="tftpc",height=0.2,width=0.4,color="gray40", fillcolor="grey60", style="filled", fontcolor="black",tooltip="TFTP client definition to maintain information relevant to the client."];
  Node2 -> Node1 [id="edge1_Node000001_Node000002",dir="back",color="darkorchid3",style="dashed",tooltip=" ",label=" server",fontcolor="grey" ];
  Node2 [id="Node000002",label="sockaddr",height=0.2,width=0.4,color="gray40", fillcolor="white", style="filled",URL="$structsockaddr.html",tooltip=" "];
  Node3 -> Node1 [id="edge2_Node000001_Node000003",dir="back",color="darkorchid3",style="dashed",tooltip=" ",label=" callback",fontcolor="grey" ];
  Node3 [id="Node000003",label="tftp_evt",height=0.2,width=0.4,color="gray40", fillcolor="white", style="filled",URL="$structtftp__evt.html",tooltip="Defines TFTP asynchronous event notified to the application."];
  Node4 -> Node3 [id="edge3_Node000003_Node000004",dir="back",color="darkorchid3",style="dashed",tooltip=" ",label=" param",fontcolor="grey" ];
  Node4 [id="Node000004",label="tftp_evt_param",height=0.2,width=0.4,color="gray40", fillcolor="white", style="filled",URL="$uniontftp__evt__param.html",tooltip="Defines event parameters notified along with asynchronous events to the application."];
  Node5 -> Node4 [id="edge4_Node000004_Node000005",dir="back",color="darkorchid3",style="dashed",tooltip=" ",label=" data",fontcolor="grey" ];
  Node5 [id="Node000005",label="tftp_data_param",height=0.2,width=0.4,color="gray40", fillcolor="white", style="filled",URL="$structtftp__data__param.html",tooltip="Parameters for data event."];
  Node6 -> Node4 [id="edge5_Node000004_Node000006",dir="back",color="darkorchid3",style="dashed",tooltip=" ",label=" error",fontcolor="grey" ];
  Node6 [id="Node000006",label="tftp_error_param",height=0.2,width=0.4,color="gray40", fillcolor="white", style="filled",URL="$structtftp__error__param.html",tooltip="Parameters for error event."];
}
