digraph "fcb_entry_ctx"
{
 // LATEX_PDF_SIZE
  bgcolor="transparent";
  edge [fontname=Helvetica,fontsize=10,labelfontname=Helvetica,labelfontsize=10];
  node [fontname=Helvetica,fontsize=10,shape=box,height=0.2,width=0.4];
  Node1 [id="Node000001",label="fcb_entry_ctx",height=0.2,width=0.4,color="gray40", fillcolor="grey60", style="filled", fontcolor="black",tooltip="Structure for transferring complete information about FCB entry location within flash memory."];
  Node2 -> Node1 [id="edge1_Node000001_Node000002",dir="back",color="darkorchid3",style="dashed",tooltip=" ",label=" loc",fontcolor="grey" ];
  Node2 [id="Node000002",label="fcb_entry",height=0.2,width=0.4,color="gray40", fillcolor="white", style="filled",URL="$structfcb__entry.html",tooltip="FCB entry info structure. This data structure describes the element location in the flash."];
  Node3 -> Node2 [id="edge2_Node000002_Node000003",dir="back",color="darkorchid3",style="dashed",tooltip=" ",label=" fe_sector",fontcolor="grey" ];
  Node3 [id="Node000003",label="flash_sector",height=0.2,width=0.4,color="gray40", fillcolor="white", style="filled",URL="$structflash__sector.html",tooltip="Structure for transfer flash sector boundaries."];
  Node4 -> Node1 [id="edge3_Node000001_Node000004",dir="back",color="darkorchid3",style="dashed",tooltip=" ",label=" fap",fontcolor="grey" ];
  Node4 [id="Node000004",label="flash_area",height=0.2,width=0.4,color="gray40", fillcolor="white", style="filled",URL="$structflash__area.html",tooltip="Flash partition."];
  Node5 -> Node4 [id="edge4_Node000004_Node000005",dir="back",color="darkorchid3",style="dashed",tooltip=" ",label=" fa_dev",fontcolor="grey" ];
  Node5 [id="Node000005",label="device",height=0.2,width=0.4,color="gray40", fillcolor="white", style="filled",URL="$structdevice.html",tooltip="Runtime device structure (in ROM) per driver instance."];
  Node6 -> Node5 [id="edge5_Node000005_Node000006",dir="back",color="darkorchid3",style="dashed",tooltip=" ",label=" state",fontcolor="grey" ];
  Node6 [id="Node000006",label="device_state",height=0.2,width=0.4,color="gray40", fillcolor="white", style="filled",URL="$structdevice__state.html",tooltip="Runtime device dynamic structure (in RAM) per driver instance."];
}
