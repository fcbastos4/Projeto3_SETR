digraph "fcb_entry"
{
 // LATEX_PDF_SIZE
  bgcolor="transparent";
  edge [fontname=Helvetica,fontsize=10,labelfontname=Helvetica,labelfontsize=10];
  node [fontname=Helvetica,fontsize=10,shape=box,height=0.2,width=0.4];
  Node1 [id="Node000001",label="fcb_entry",height=0.2,width=0.4,color="gray40", fillcolor="grey60", style="filled", fontcolor="black",tooltip="FCB entry info structure. This data structure describes the element location in the flash."];
  Node2 -> Node1 [id="edge1_Node000001_Node000002",dir="back",color="darkorchid3",style="dashed",tooltip=" ",label=" fe_sector",fontcolor="grey" ];
  Node2 [id="Node000002",label="flash_sector",height=0.2,width=0.4,color="gray40", fillcolor="white", style="filled",URL="$structflash__sector.html",tooltip="Structure for transfer flash sector boundaries."];
