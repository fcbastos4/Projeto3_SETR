  Node1 [id="Node000001",label="flash_img_context",height=0.2,width=0.4,color="gray40", fillcolor="grey60", style="filled", fontcolor="black",tooltip=" "];
  Node2 -> Node1 [id="edge1_Node000001_Node000002",dir="back",color="darkorchid3",style="dashed",tooltip=" ",label=" flash_area",fontcolor="grey" ];
  Node2 [id="Node000002",label="flash_area",height=0.2,width=0.4,color="gray40", fillcolor="white", style="filled",URL="$structflash__area.html",tooltip="Flash partition."];
  Node3 -> Node2 [id="edge2_Node000002_Node000003",dir="back",color="darkorchid3",style="dashed",tooltip=" ",label=" fa_dev",fontcolor="grey" ];
  Node3 [id="Node000003",label="device",height=0.2,width=0.4,color="gray40", fillcolor="white", style="filled",URL="$structdevice.html",tooltip="Runtime device structure (in ROM) per driver instance."];
  Node4 -> Node3 [id="edge3_Node000003_Node000004",dir="back",color="darkorchid3",style="dashed",tooltip=" ",label=" state",fontcolor="grey" ];
  Node4 [id="Node000004",label="device_state",height=0.2,width=0.4,color="gray40", fillcolor="white", style="filled",URL="$structdevice__state.html",tooltip="Runtime device dynamic structure (in RAM) per driver instance."];
  Node5 -> Node1 [id="edge4_Node000001_Node000005",dir="back",color="darkorchid3",style="dashed",tooltip=" ",label=" stream",fontcolor="grey" ];
  Node5 [id="Node000005",label="stream_flash_ctx",height=0.2,width=0.4,color="gray40", fillcolor="white", style="filled",URL="$structstream__flash__ctx.html",tooltip="Structure for stream flash context."];
  Node3 -> Node5 [id="edge5_Node000005_Node000003",dir="back",color="darkorchid3",style="dashed",tooltip=" ",label=" fdev",fontcolor="grey" ];
