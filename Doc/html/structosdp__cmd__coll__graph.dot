digraph "osdp_cmd"
{
 // LATEX_PDF_SIZE
  bgcolor="transparent";
  edge [fontname=Helvetica,fontsize=10,labelfontname=Helvetica,labelfontsize=10];
  node [fontname=Helvetica,fontsize=10,shape=box,height=0.2,width=0.4];
  rankdir="LR";
  Node1 [id="Node000001",label="osdp_cmd",height=0.2,width=0.4,color="gray40", fillcolor="grey60", style="filled", fontcolor="black",tooltip="OSDP Command Structure. This is a wrapper for all individual OSDP commands."];
  Node2 -> Node1 [id="edge1_Node000001_Node000002",dir="back",color="darkorchid3",style="dashed",tooltip=" ",label=" led",fontcolor="grey" ];
  Node2 [id="Node000002",label="osdp_cmd_led",height=0.2,width=0.4,color="gray40", fillcolor="white", style="filled",URL="$structosdp__cmd__led.html",tooltip="Sent from CP to PD to control the behaviour of it's on-board LEDs."];
  Node3 -> Node2 [id="edge2_Node000002_Node000003",dir="back",color="darkorchid3",style="dashed",tooltip=" ",label=" permanent\ntemporary",fontcolor="grey" ];
  Node3 [id="Node000003",label="osdp_cmd_led_params",height=0.2,width=0.4,color="gray40", fillcolor="white", style="filled",URL="$structosdp__cmd__led__params.html",tooltip="LED params sub-structure. Part of LED command. See struct osdp_cmd_led."];
  Node4 -> Node1 [id="edge3_Node000001_Node000004",dir="back",color="darkorchid3",style="dashed",tooltip=" ",label=" buzzer",fontcolor="grey" ];
  Node4 [id="Node000004",label="osdp_cmd_buzzer",height=0.2,width=0.4,color="gray40", fillcolor="white", style="filled",URL="$structosdp__cmd__buzzer.html",tooltip="Sent from CP to control the behaviour of a buzzer in the PD."];
  Node5 -> Node1 [id="edge4_Node000001_Node000005",dir="back",color="darkorchid3",style="dashed",tooltip=" ",label=" text",fontcolor="grey" ];
  Node5 [id="Node000005",label="osdp_cmd_text",height=0.2,width=0.4,color="gray40", fillcolor="white", style="filled",URL="$structosdp__cmd__text.html",tooltip="Command to manipulate any display units that the PD supports."];
  Node6 -> Node1 [id="edge5_Node000001_Node000006",dir="back",color="darkorchid3",style="dashed",tooltip=" ",label=" output",fontcolor="grey" ];
  Node6 [id="Node000006",label="osdp_cmd_output",height=0.2,width=0.4,color="gray40", fillcolor="white", style="filled",URL="$structosdp__cmd__output.html",tooltip="Command sent from CP to Control digital output of PD."];
  Node7 -> Node1 [id="edge6_Node000001_Node000007",dir="back",color="darkorchid3",style="dashed",tooltip=" ",label=" comset",fontcolor="grey" ];
  Node7 [id="Node000007",label="osdp_cmd_comset",height=0.2,width=0.4,color="gray40", fillcolor="white", style="filled",URL="$structosdp__cmd__comset.html",tooltip="Sent in response to a COMSET command. Set communication parameters to PD. Must be stored in PD non-vo..."];
  Node8 -> Node1 [id="edge7_Node000001_Node000008",dir="back",color="darkorchid3",style="dashed",tooltip=" ",label=" keyset",fontcolor="grey" ];
  Node8 [id="Node000008",label="osdp_cmd_keyset",height=0.2,width=0.4,color="gray40", fillcolor="white", style="filled",URL="$structosdp__cmd__keyset.html",tooltip="This command transfers an encryption key from the CP to a PD."];
}
