digraph "onoff_manager"
{
 // LATEX_PDF_SIZE
  bgcolor="transparent";
  edge [fontname=Helvetica,fontsize=10,labelfontname=Helvetica,labelfontsize=10];
  node [fontname=Helvetica,fontsize=10,shape=box,height=0.2,width=0.4];
  Node1 [id="Node000001",label="onoff_manager",height=0.2,width=0.4,color="gray40", fillcolor="grey60", style="filled", fontcolor="black",tooltip="State associated with an on-off manager."];
  Node2 -> Node1 [id="edge1_Node000001_Node000002",dir="back",color="darkorchid3",style="dashed",tooltip=" ",label=" transitions",fontcolor="grey" ];
  Node2 [id="Node000002",label="onoff_transitions",height=0.2,width=0.4,color="gray40", fillcolor="white", style="filled",URL="$structonoff__transitions.html",tooltip="On-off service transition functions."];
  Node1 -> Node2 [id="edge2_Node000002_Node000001",dir="back",color="darkorchid3",style="dashed",tooltip=" ",label=" reset\nstart\nstop",fontcolor="grey" ];
  Node3 -> Node1 [id="edge3_Node000001_Node000003",dir="back",color="darkorchid3",style="dashed",tooltip=" ",label=" lock",fontcolor="grey" ];
  Node3 [id="Node000003",label="k_spinlock",height=0.2,width=0.4,color="gray40", fillcolor="white", style="filled",URL="$structk__spinlock.html",tooltip="Kernel Spin Lock."];
}
