digraph "net_stats_eth"
{
 // LATEX_PDF_SIZE
  bgcolor="transparent";
  edge [fontname=Helvetica,fontsize=10,labelfontname=Helvetica,labelfontsize=10];
  node [fontname=Helvetica,fontsize=10,shape=box,height=0.2,width=0.4];
  rankdir="LR";
  Node1 [id="Node000001",label="net_stats_eth",height=0.2,width=0.4,color="gray40", fillcolor="grey60", style="filled", fontcolor="black",tooltip="All Ethernet specific statistics."];
  Node2 -> Node1 [id="edge1_Node000001_Node000002",dir="back",color="darkorchid3",style="dashed",tooltip=" ",label=" bytes",fontcolor="grey" ];
  Node2 [id="Node000002",label="net_stats_bytes",height=0.2,width=0.4,color="gray40", fillcolor="white", style="filled",URL="$structnet__stats__bytes.html",tooltip="Number of bytes sent and received."];
  Node3 -> Node1 [id="edge2_Node000001_Node000003",dir="back",color="darkorchid3",style="dashed",tooltip=" ",label=" broadcast\nerrors\nmulticast\npkts",fontcolor="grey" ];
  Node3 [id="Node000003",label="net_stats_pkts",height=0.2,width=0.4,color="gray40", fillcolor="white", style="filled",URL="$structnet__stats__pkts.html",tooltip="Number of network packets sent and received."];
  Node4 -> Node1 [id="edge3_Node000001_Node000004",dir="back",color="darkorchid3",style="dashed",tooltip=" ",label=" error_details",fontcolor="grey" ];
  Node4 [id="Node000004",label="net_stats_eth_errors",height=0.2,width=0.4,color="gray40", fillcolor="white", style="filled",URL="$structnet__stats__eth__errors.html",tooltip="Ethernet error statistics."];
  Node5 -> Node1 [id="edge4_Node000001_Node000005",dir="back",color="darkorchid3",style="dashed",tooltip=" ",label=" flow_control",fontcolor="grey" ];
  Node5 [id="Node000005",label="net_stats_eth_flow",height=0.2,width=0.4,color="gray40", fillcolor="white", style="filled",URL="$structnet__stats__eth__flow.html",tooltip="Ethernet flow control statistics."];
  Node6 -> Node1 [id="edge5_Node000001_Node000006",dir="back",color="darkorchid3",style="dashed",tooltip=" ",label=" csum",fontcolor="grey" ];
  Node6 [id="Node000006",label="net_stats_eth_csum",height=0.2,width=0.4,color="gray40", fillcolor="white", style="filled",URL="$structnet__stats__eth__csum.html",tooltip="Ethernet checksum statistics."];
  Node7 -> Node1 [id="edge6_Node000001_Node000007",dir="back",color="darkorchid3",style="dashed",tooltip=" ",label=" hw_timestamp",fontcolor="grey" ];
  Node7 [id="Node000007",label="net_stats_eth_hw_timestamp",height=0.2,width=0.4,color="gray40", fillcolor="white", style="filled",URL="$structnet__stats__eth__hw__timestamp.html",tooltip="Ethernet hardware timestamp statistics."];
}
