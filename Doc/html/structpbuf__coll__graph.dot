digraph "pbuf"
{
 // LATEX_PDF_SIZE
  bgcolor="transparent";
  edge [fontname=Helvetica,fontsize=10,labelfontname=Helvetica,labelfontsize=10];
  node [fontname=Helvetica,fontsize=10,shape=box,height=0.2,width=0.4];
  Node1 [id="Node000001",label="pbuf",height=0.2,width=0.4,color="gray40", fillcolor="grey60", style="filled", fontcolor="black",tooltip="Scure packed buffer."];
  Node2 -> Node1 [id="edge1_Node000001_Node000002",dir="back",color="darkorchid3",style="dashed",tooltip=" ",label=" cfg",fontcolor="grey" ];
  Node2 [id="Node000002",label="pbuf_cfg",height=0.2,width=0.4,color="gray40", fillcolor="white", style="filled",URL="$structpbuf__cfg.html",tooltip="Control block of packet buffer."];
  Node3 -> Node1 [id="edge2_Node000001_Node000003",dir="back",color="darkorchid3",style="dashed",tooltip=" ",label=" data",fontcolor="grey" ];
  Node3 [id="Node000003",label="pbuf_data",height=0.2,width=0.4,color="gray40", fillcolor="white", style="filled",URL="$structpbuf__data.html",tooltip="Data block of the packed buffer."];
}
