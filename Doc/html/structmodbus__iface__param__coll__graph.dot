digraph "modbus_iface_param"
{
 // LATEX_PDF_SIZE
  bgcolor="transparent";
  edge [fontname=Helvetica,fontsize=10,labelfontname=Helvetica,labelfontsize=10];
  node [fontname=Helvetica,fontsize=10,shape=box,height=0.2,width=0.4];
  Node1 [id="Node000001",label="modbus_iface_param",height=0.2,width=0.4,color="gray40", fillcolor="grey60", style="filled", fontcolor="black",tooltip="User parameter structure to configure Modbus interface as client or server."];
  Node2 -> Node1 [id="edge1_Node000001_Node000002",dir="back",color="darkorchid3",style="dashed",tooltip=" ",label=" server",fontcolor="grey" ];
  Node2 [id="Node000002",label="modbus_server_param",height=0.2,width=0.4,color="gray40", fillcolor="white", style="filled",URL="$structmodbus__server__param.html",tooltip="Modbus server parameter."];
  Node3 -> Node2 [id="edge2_Node000002_Node000003",dir="back",color="darkorchid3",style="dashed",tooltip=" ",label=" user_cb",fontcolor="grey" ];
  Node3 [id="Node000003",label="modbus_user_callbacks",height=0.2,width=0.4,color="gray40", fillcolor="white", style="filled",URL="$structmodbus__user__callbacks.html",tooltip=" "];
  Node4 -> Node1 [id="edge3_Node000001_Node000004",dir="back",color="darkorchid3",style="dashed",tooltip=" ",label=" serial",fontcolor="grey" ];
  Node4 [id="Node000004",label="modbus_serial_param",height=0.2,width=0.4,color="gray40", fillcolor="white", style="filled",URL="$structmodbus__serial__param.html",tooltip="Modbus serial line parameter."];
  Node5 -> Node1 [id="edge4_Node000001_Node000005",dir="back",color="darkorchid3",style="dashed",tooltip=" ",label=" rawcb",fontcolor="grey" ];
  Node5 [id="Node000005",label="modbus_raw_cb",height=0.2,width=0.4,color="grey75", fillcolor="white", style="filled",URL="$structmodbus__raw__cb.html",tooltip=" "];
  Node6 -> Node5 [id="edge5_Node000005_Node000006",dir="back",color="darkorchid3",style="dashed",tooltip=" ",label=" raw_tx_cb",fontcolor="grey" ];
  Node6 [id="Node000006",label="modbus_adu",height=0.2,width=0.4,color="gray40", fillcolor="white", style="filled",URL="$structmodbus__adu.html",tooltip="Frame struct used internally and for raw ADU support."];
}
