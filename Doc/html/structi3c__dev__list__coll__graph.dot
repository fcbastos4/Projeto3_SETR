digraph "i3c_dev_list"
{
 // LATEX_PDF_SIZE
  bgcolor="transparent";
  edge [fontname=Helvetica,fontsize=10,labelfontname=Helvetica,labelfontsize=10];
  node [fontname=Helvetica,fontsize=10,shape=box,height=0.2,width=0.4];
  Node1 [id="Node000001",label="i3c_dev_list",height=0.2,width=0.4,color="gray40", fillcolor="grey60", style="filled", fontcolor="black",tooltip="Structure for describing known devices for a controller."];
  Node2 -> Node1 [id="edge1_Node000001_Node000002",dir="back",color="darkorchid3",style="dashed",tooltip=" ",label=" i3c",fontcolor="grey" ];
  Node2 [id="Node000002",label="i3c_device_desc",height=0.2,width=0.4,color="gray40", fillcolor="white", style="filled",URL="$structi3c__device__desc.html",tooltip="Structure describing a I3C target device."];
  Node3 -> Node2 [id="edge2_Node000002_Node000003",dir="back",color="darkorchid3",style="dashed",tooltip=" ",label=" bus\ndev",fontcolor="grey" ];
  Node3 [id="Node000003",label="device",height=0.2,width=0.4,color="gray40", fillcolor="white", style="filled",URL="$structdevice.html",tooltip="Runtime device structure (in ROM) per driver instance."];
  Node4 -> Node3 [id="edge3_Node000003_Node000004",dir="back",color="darkorchid3",style="dashed",tooltip=" ",label=" state",fontcolor="grey" ];
  Node4 [id="Node000004",label="device_state",height=0.2,width=0.4,color="gray40", fillcolor="white", style="filled",URL="$structdevice__state.html",tooltip="Runtime device dynamic structure (in RAM) per driver instance."];
  Node5 -> Node1 [id="edge4_Node000001_Node000005",dir="back",color="darkorchid3",style="dashed",tooltip=" ",label=" i2c",fontcolor="grey" ];
  Node5 [id="Node000005",label="i3c_i2c_device_desc",height=0.2,width=0.4,color="gray40", fillcolor="white", style="filled",URL="$structi3c__i2c__device__desc.html",tooltip="Structure describing a I2C device on I3C bus."];
  Node3 -> Node5 [id="edge5_Node000005_Node000003",dir="back",color="darkorchid3",style="dashed",tooltip=" ",label=" bus",fontcolor="grey" ];
}
