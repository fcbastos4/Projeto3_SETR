digraph "display_driver_api"
{
 // LATEX_PDF_SIZE
  bgcolor="transparent";
  edge [fontname=Helvetica,fontsize=10,labelfontname=Helvetica,labelfontsize=10];
  node [fontname=Helvetica,fontsize=10,shape=box,height=0.2,width=0.4];
  Node1 [id="Node000001",label="display_driver_api",height=0.2,width=0.4,color="gray40", fillcolor="grey60", style="filled", fontcolor="black",tooltip="Display driver API API which a display driver should expose."];
  Node2 -> Node1 [id="edge1_Node000001_Node000002",dir="back",color="darkorchid3",style="dashed",tooltip=" ",label=" blanking_off\nblanking_on\nget_capabilities\nget_framebuffer\nread\nset_brightness\nset_contrast\nset_orientation\nset_pixel_format\nwrite\n...",fontcolor="grey" ];
  Node2 [id="Node000002",label="device",height=0.2,width=0.4,color="gray40", fillcolor="white", style="filled",URL="$structdevice.html",tooltip="Runtime device structure (in ROM) per driver instance."];
  Node3 -> Node2 [id="edge2_Node000002_Node000003",dir="back",color="darkorchid3",style="dashed",tooltip=" ",label=" state",fontcolor="grey" ];
  Node3 [id="Node000003",label="device_state",height=0.2,width=0.4,color="gray40", fillcolor="white", style="filled",URL="$structdevice__state.html",tooltip="Runtime device dynamic structure (in RAM) per driver instance."];
}
