// The provided address in the datasheet is an 8-bit address 1001 101b.
// Therefore, it must be logically shifted to the right by 1 bit to get the 7-bit address.
// 1001 101b -> 100 1101 = 4d

&i2c0 {
    tc74sensor: tc74sensor@4d{
        compatible = "i2c-device";
        reg = < 0x4d >;
        label = "TC74SENSOR";
    };
};